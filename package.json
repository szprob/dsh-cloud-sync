{
  "name": "dsh-cloud-sync",
  "version": "1.0.3",
  "description": "把 DeepSeek Harness 的配置同步到你自己的 GitHub 仓库：配好 token 与 repo 后一键备份 / 一键恢复，新机器装插件就能拉回全套配置。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sync",
    "backup",
    "github",
    "configuration"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node tests/smoke.mjs"
  },
  "license": "MIT",
  "author": "songze",
  "homepage": "https://github.com/szprob/dsh-cloud-sync",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szprob/dsh-cloud-sync.git"
  },
  "bugs": {
    "url": "https://github.com/szprob/dsh-cloud-sync/issues"
  }
}
